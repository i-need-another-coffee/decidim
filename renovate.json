{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    // ==========================================
    // 🚫 IGNORE INTERNAL DECIDIM-* GEMS
    // ==========================================
    {
      "description": "Do not update internal decidim-* gems - they use version constants",
      "matchDatasources": ["rubygems"],
      "matchPackagePatterns": ["^decidim-"],
      "enabled": false
    },
    // ==========================================
    // 📦 ALL RUBY GEMS - UPDATE GEMSPECS
    // ==========================================
    {
      "description": "Update all external Ruby gems in gemspec files with bump strategy",
      "matchDatasources": ["rubygems"],
      "matchFileNames": ["**/*.gemspec"],
      "rangeStrategy": "bump",
      "enabled": true
    },
    // ==========================================
    // 🚂 RAILS FRAMEWORK
    // ==========================================
    {
      "description": "Group all Rails-related gems together",
      "matchDatasources": ["rubygems"],
      "matchPackagePatterns": [
        "^rails$",
        "^railties$",
        "^actionpack$",
        "^actioncable$",
        "^actionmailbox$",
        "^actionmailer$",
        "^actiontext$",
        "^actionview$",
        "^activejob$",
        "^activemodel$",
        "^activerecord$",
        "^activestorage$",
        "^activesupport$"
      ],
      "groupName": "Rails framework",
      "rangeStrategy": "bump",
      "labels": ["dependencies", "rails"]
    }
  ], 
  
  "bundler": {
    "enabled":  true,
    "rangeStrategy": "bump"  // Key setting:  updates ~> 4.7 to ~> 4.9
  },
  "npm": {
    "enabled": true,
    "rangeStrategy": "bump"
  },
  // ============================================
  // GITHUB ACTIONS CONFIGURATION
  // ============================================
  "github-actions": {
    "enabled": true,
    "pinDigests": true
  }
}
