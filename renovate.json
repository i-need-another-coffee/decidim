{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "bundler": {
    "enabled": true,
    "rangeStrategy": "bump",
    "fileMatch": [
      "Gemfile", 
      "decidim-accountability/decidim-accountability.gemspec",
      "decidim-admin/decidim-admin.gemspec",
      "decidim-ai/decidim-ai.gemspec"
    ], 
    "matchFileNames": [
      "decidim-conferences/decidim-conferences.gemspec",
      "decidim-core/decidim-core.gemspec"
    ]
 },
 "npm": {
   "enabled": true,
   "rangeStrategy":  "bump"
 },
  "github-actions": {
    "enabled":  true,
    "pinDigests": true
  },
  "prConcurrentLimit": 2,
  "prCreation": "immediate",
  "automerge": false,
  "prHourlyLimit": 5
}
