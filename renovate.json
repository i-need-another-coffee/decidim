{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "bundler": {
    "enabled": true,
    "rangeStrategy": "bump",
    "managerFilePatterns": [
      "/^Gemfile$/", 
      "/^decidim-generators\\/Gemfile$/",
      "/^decidim-generators\\/lib\\/decidim\\/generators\\/component_templates\\/Gemfile\\.erb$/",
      "/^decidim-core\\/decidim-core\\.gemspec$/",
      "/\\.gemspec$/"
    ]
 },
 "npm": {
   "enabled": true,
   "rangeStrategy":  "bump"
 },
  "github-actions": {
    "enabled":  true,
    "pinDigests": true
  },
  "prConcurrentLimit": 2,
  "prCreation": "immediate",
  "automerge": false,
  "prHourlyLimit": 5
}
