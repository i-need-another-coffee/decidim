{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ], 
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        ".*\\/*\\.gemspec"
      ],
      "matchStrings": [
        ".*\\.add_(:?(?<depType>.*?)_)?dependency\\s*(['\"])(?<depName>[^'\"]+)(['\"])(\\s*,\\s*(?<currentValue>(['\"])[^'\"]+['\"](\\s*,\\s*['\"][^'\"]+['\"])?))?"
      ],
      "datasourceTemplate": "rubygems",
      "versioningTemplate": "ruby"
    }
  ],
  "packageRules": [
     // Rails ecosystem
    {
      "groupName": "Rails",
      "matchPackagePatterns": ["^rails", "^action", "^active"],
      "rangeStrategy": "bump"
    },
    // Update gemspec constraints
    {
      "matchFileNames": ["**/*.gemspec"],
      "enabled": true,
      "matchDatasources": [
        "rubygems"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "rangeStrategy": "bump"
    },
    // Security updates - high priority
    {
      "matchUpdateTypes": ["patch"],
      "matchPackagePatterns": ["devise", "doorkeeper", "omniauth"],
      "automerge": false,
      "labels": ["security", "automerge"]
    }
  ], 
  
  "bundler": {
    "enabled":  true,
    "rangeStrategy": "bump"  // Key setting:  updates ~> 4.7 to ~> 4.9
  }, 
  
  "npm": {
    "enabled": true,
    "rangeStrategy": "bump"
  }
}
