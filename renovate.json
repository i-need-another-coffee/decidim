{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    // ==========================================
    // 🚫 IGNORE INTERNAL DECIDIM-* GEMS
    // ==========================================
    {
      "description": "Do not update internal decidim-* gems - they use version constants",
      "matchDatasources": ["rubygems"],
      "matchPackagePatterns": ["^decidim-"],
      "enabled": false
    },
    // ==========================================
    // 📦 ALL RUBY GEMS - UPDATE ALL GEMSPECS
    // ==========================================
    {
      "description": "Update all external Ruby gems in ALL decidim-* gemspec files with bump strategy",
      "matchDatasources": ["rubygems"],
      "matchFileNames": [
        "decidim-accountability/decidim-accountability.gemspec",
        "decidim-admin/decidim-admin.gemspec",
        "decidim-ai/decidim-ai.gemspec",
        "decidim-api/decidim-api.gemspec",
        "decidim-assemblies/decidim-assemblies.gemspec",
        "decidim-blogs/decidim-blogs.gemspec",
        "decidim-budgets/decidim-budgets. gemspec",
        "decidim-collaborative_texts/decidim-collaborative_texts.gemspec",
        "decidim-comments/decidim-comments.gemspec",
        "decidim-conferences/decidim-conferences.gemspec",
        "decidim-consultations/decidim-consultations.gemspec",
        "decidim-core/decidim-core.gemspec",
        "decidim-debates/decidim-debates.gemspec",
        "decidim-demographics/decidim-demographics.gemspec",
        "decidim-design/decidim-design.gemspec",
        "decidim-dev/decidim-dev.gemspec",
        "decidim-elections/decidim-elections.gemspec",
        "decidim-forms/decidim-forms.gemspec",
        "decidim-generators/decidim-generators.gemspec",
        "decidim-initiatives/decidim-initiatives.gemspec",
        "decidim-meetings/decidim-meetings.gemspec",
        "decidim-pages/decidim-pages.gemspec",
        "decidim-participatory_processes/decidim-participatory_processes.gemspec",
        "decidim-proposals/decidim-proposals.gemspec",
        "decidim-system/decidim-system.gemspec",
        "decidim-templates/decidim-templates.gemspec",
        "decidim-verifications/decidim-verifications. gemspec",
        "decidim.gemspec"
      ],
      "rangeStrategy": "bump",
      "enabled": true,
      "groupName": "decidim module dependencies",
      "labels": ["dependencies", "gemspec-updates"],
      "semanticCommits": "enabled",
      "commitMessagePrefix": "chore(deps):",
      "commitMessageTopic": "{{depName}} in {{packageFile}}",
      "commitMessageExtra": "to {{newVersion}}"
    },
    // ==========================================
    // 🚂 RAILS FRAMEWORK
    // ==========================================
    {
      "description": "Group all Rails-related gems together",
      "matchDatasources": ["rubygems"],
      "matchPackagePatterns": [
        "^rails$",
        "^railties$",
        "^actionpack$",
        "^actioncable$",
        "^actionmailbox$",
        "^actionmailer$",
        "^actiontext$",
        "^actionview$",
        "^activejob$",
        "^activemodel$",
        "^activerecord$",
        "^activestorage$",
        "^activesupport$"
      ],
      "groupName": "Rails framework",
      "rangeStrategy": "bump",
      "labels": ["dependencies", "rails"]
    },
    // ==========================================
    // 🔒 SECURITY UPDATES - HIGH PRIORITY
    // ==========================================
    {
      "description": "Prioritize security updates for all gemspec files",
      "matchDatasources": ["rubygems"],
      "matchFileNames": ["**/decidim-*. gemspec"],
      "matchUpdateTypes": ["patch"],
      "labels": ["security", "dependencies", "priority-high"],
      "automerge": false
    }
  ], 
  
  "bundler": {
    "enabled": true,
    "rangeStrategy": "bump",
    "fileMatch": [
      "(^|/)Gemfile$",
      "\\.gemspec$",
      "**/decidim-.*\\.gemspec$"
    ]
  },
  "npm": {
    "enabled": true,
    "rangeStrategy":  "bump"
  },
  // ============================================
  // GITHUB ACTIONS CONFIGURATION
  // ============================================
  "github-actions": {
    "enabled":  true,
    "pinDigests": true
  },
  // ============================================
  // RATE LIMITING & PR CONFIGURATION
  // ============================================
  "prConcurrentLimit": 10,
  "prHourlyLimit": 5,
  "prCreation": "immediate",
  "automerge": false,
  // ============================================
  // VULNERABILITY ALERTS
  // ============================================
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "vulnerability"]
  }
}
