<% add_decidim_page_title(t(".page_title")) %>

<% content_for :profile_title do %>
  <%= t(".page_title") %>
<% end %>

<%= render layout: "layouts/decidim/shared/layout_user_profile" do %>
  <%= render partial: "token", as: :token, collection: current_user.access_tokens %>

  <div class="py-10 flex flex-col gap-4">
    <%= link_to t("decidim.api.tokens.index.new_token"), new_token_path, class: "button button__sm md:button__lg button__secondary mr-auto !ml-0" %>
  </div>
<% end %>
